# Agent check-in credential. Keep the real value only in .env.
ICL_ACCESS_KEY=

# Optional LI.FI server-side API credential. The public Day 4 probe does not require it.
LIFI_API_KEY=

# Read-only EVM endpoints. URLs may contain credentials and are never persisted.
BASE_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
